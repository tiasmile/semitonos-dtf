#: semitonos.py:28
msgid "Semitonos para DTF"
msgstr "Meios-tons para DTF"

#: semitonos.py:32
msgid "Blanca"
msgstr "Branca"

#: semitonos.py:32
msgid "Gris"
msgstr "Cinza"

#: semitonos.py:32
msgid "Negra"
msgstr "Preta"

#: semitonos.py:33
msgid "Azul marino"
msgstr "Azul-marinho"

#: semitonos.py:33
msgid "Roja"
msgstr "Vermelha"

#: semitonos.py:33
msgid "Verde botella"
msgstr "Verde-garrafa"

#: semitonos.py:34
msgid "Comparar"
msgstr "Comparar"

#: semitonos.py:34 semitonos.py:895
msgid "Original"
msgstr "Original"

#: semitonos.py:34 semitonos.py:896
msgid "Resultado"
msgstr "Resultado"

#: semitonos.py:35
msgid "Ajustar"
msgstr "Ajustar"

#: semitonos.py:36
msgid "Blanco"
msgstr "Branco"

#: semitonos.py:36
msgid "Color elegido"
msgstr "Cor escolhida"

#: semitonos.py:36
msgid "Negro"
msgstr "Preto"

#: semitonos.py:38
msgid "Barra: arrastrar para comparar · rueda: acercar o alejar · botón derecho: mover la imagen · doble clic: ver entera"
msgstr "Barra: arraste para comparar · roda do mouse: aproximar ou afastar · botão direito: mover a imagem · clique duplo: ver a imagem inteira"

#: semitonos.py:243
msgid "☀  Modo claro"
msgstr "☀  Modo claro"

#: semitonos.py:243
msgid "☾  Modo oscuro"
msgstr "☾  Modo escuro"

#: semitonos.py:290
msgid "1. Imagen"
msgstr "1. Imagem"

#: semitonos.py:298
msgid "Abrir imagen…"
msgstr "Abrir imagem…"

#: semitonos.py:328
msgid "Fondo de la vista:"
msgstr "Fundo da visualização:"

#: semitonos.py:335
msgid "Solo cambia lo que ves: el PNG que se guarda no lleva fondo."
msgstr "Só muda o que você vê: o PNG salvo não tem fundo."

#: semitonos.py:336
msgid "El color de la camiseta elegido abajo"
msgstr "A cor da camiseta escolhida abaixo"

#: semitonos.py:422
msgid "2. Tamaño de impresión"
msgstr "2. Tamanho de impressão"

#: semitonos.py:424 semitonos.py:488
msgid "Ancho"
msgstr "Largura"

#: semitonos.py:428
msgid "Alto"
msgstr "Altura"

#. TRADUCTORES: en «Ancho 25 cm  Alto 20 cm  a 300 ppp», la palabra «a» introduce la resolución
#: semitonos.py:436
msgctxt "tamaño de impresión: «25 cm a 300 ppp»"
msgid "a"
msgstr "a"

#. TRADUCTORES: unidad de resolución de impresión (puntos por pulgada), «dpi» en inglés
#: semitonos.py:439
msgid "ppp"
msgstr "dpi"

#: semitonos.py:444
msgid "3. Color de la camiseta"
msgstr "3. Cor da camiseta"

#: semitonos.py:459
msgid "Otro…"
msgstr "Outra…"

#. TRADUCTORES: herramienta para coger un color pulsando sobre la imagen (eyedropper / pipette)
#: semitonos.py:463
msgid "Cuentagotas"
msgstr "Conta-gotas"

#: semitonos.py:471
msgid "Quitar el color de la camiseta de la imagen"
msgstr "Remover a cor da camiseta da imagem"

#. TRADUCTORES: umbral. Los colores más parecidos al de la camiseta que este valor se vuelven transparentes
#: semitonos.py:473
msgid "Quitar hasta"
msgstr "Remover até"

#. TRADUCTORES: umbral. Los colores más distintos al de la camiseta que este valor quedan totalmente opacos
#: semitonos.py:475
msgid "Opaco desde"
msgstr "Opaco a partir de"

#: semitonos.py:476
msgid "Más parecido que «Quitar hasta»: desaparece. Más distinto que «Opaco desde»: sólido. Lo de en medio: puntos."
msgstr "Mais parecido com a cor da camiseta do que «Remover até»: desaparece. Mais diferente do que «Opaco a partir de»: sólido. No meio: pontos."

#: semitonos.py:480
msgid "4. Degradado del borde"
msgstr "4. Degradê da borda"

#: semitonos.py:493
msgid "Del 100 % al 0 % con puntos. Hacia dentro difumina el borde; hacia fuera añade un margen alargando los colores. Ovalado / Redondo: en elipse o círculo, sin esquinas."
msgstr "De 100 % a 0 % com pontos. «Para dentro» suaviza a borda; «Para fora» adiciona uma margem alongando as cores. Oval / Redondo: em elipse ou círculo, sem cantos."

#: semitonos.py:498
msgid "5. Semitono"
msgstr "5. Meio-tom"

#: semitonos.py:499
msgid "Convertir la transparencia en puntos"
msgstr "Converter a transparência em pontos"

#. TRADUCTORES: lineatura de la trama (líneas por pulgada, lpi): cuántas filas de puntos caben en una pulgada
#: semitonos.py:502
msgid "Lineatura"
msgstr "Lineatura"

#: semitonos.py:506
msgid "Ángulo"
msgstr "Ângulo"

#: semitonos.py:512
msgid "Forma del punto"
msgstr "Forma do ponto"

#. TRADUCTORES: tamaño del punto de la trama (en %); por debajo del mínimo el punto se elimina
#: semitonos.py:517
msgid "Punto mínimo"
msgstr "Ponto mínimo"

#: semitonos.py:518
msgid "Punto máximo"
msgstr "Ponto máximo"

#. TRADUCTORES: «no agarran» = los puntos demasiado pequeños no se adhieren a la tela al estampar. «Sólido» = totalmente relleno
#: semitonos.py:520
msgid "Lineatura más baja = puntos más grandes. Los puntos más pequeños que el mínimo se quitan (no agarran); por encima del máximo, sólido."
msgstr "Lineatura menor = pontos maiores. Os pontos menores que o mínimo são removidos (não aderem); acima do máximo, sólido."

#: semitonos.py:525
msgid "Guardar PNG para DTF"
msgstr "Salvar PNG para DTF"

#: semitonos.py:534
msgid "Abrir carpeta"
msgstr "Abrir pasta"

#: semitonos.py:644
msgid "↓   Arrastra aquí la imagen (PNG, JPG, TIFF, WEBP)"
msgstr "↓   Arraste a imagem para cá (PNG, JPG, TIFF, WEBP)"

#: semitonos.py:658
msgid "Arrastra una imagen PNG, JPG, TIFF o WEBP."
msgstr "Arraste uma imagem PNG, JPG, TIFF ou WEBP."

#: semitonos.py:658
msgid "Formato no admitido"
msgstr "Formato não suportado"

#: semitonos.py:662
msgid "Elegir imagen"
msgstr "Escolher imagem"

#: semitonos.py:663
msgid "Imágenes"
msgstr "Imagens"

#: semitonos.py:663
msgid "Todos"
msgstr "Todos"

#: semitonos.py:673
msgid "No se puede abrir"
msgstr "Não foi possível abrir"

#: semitonos.py:673
#, python-brace-format
msgid ""
"No se puede abrir la imagen:\n"
"{error}"
msgstr ""
"Não foi possível abrir a imagem:\n"
"{error}"

#: semitonos.py:702 semitonos.py:863
msgid "Calculando…"
msgstr "Calculando…"

#: semitonos.py:739
msgid "No hay memoria suficiente para este tamaño. Baja el ancho o la resolución."
msgstr "Memória insuficiente para este tamanho. Reduza a largura ou a resolução."

#: semitonos.py:764
#, python-brace-format
msgid "✔ Guardado: {nombre}"
msgstr "✔ Salvo: {nombre}"

#: semitonos.py:774
msgid "No se ha podido guardar"
msgstr "Não foi possível salvar"

#: semitonos.py:863
msgid "Arrastra aquí una imagen para empezar"
msgstr "Arraste uma imagem para cá para começar"

#: semitonos.py:897
msgid "(ajustado)"
msgstr "(ajustado)"

#: semitonos.py:899
msgid "Haz clic en el color de la camiseta (Esc para cancelar)"
msgstr "Clique na cor da camiseta (Esc para cancelar)"

#: semitonos.py:969
msgid "Color de la camiseta"
msgstr "Cor da camiseta"

#: semitonos.py:1018
#, python-brace-format
msgid "Impresión: {ancho} × {alto} cm a {ppp} ppp ({w} × {h} px)"
msgstr "Impressão: {ancho} × {alto} cm a {ppp} dpi ({w} × {h} px)"

#: semitonos.py:1021
#, python-brace-format
msgid "trama de {mm} mm"
msgstr "passo da retícula {mm} mm"

#: semitonos.py:1025
#, python-brace-format
msgid "⚠ Poca resolución: la imagen original da {ppp} ppp a este tamaño. Se verá borrosa (mejor no pasar de {cm} cm)."
msgstr "⚠ Baixa resolução: a imagem original dá {ppp} dpi neste tamanho. Ficará desfocada (melhor não passar de {cm} cm)."

#: semitonos.py:1046 semitonos.py:1047
msgid "Guardando…"
msgstr "Salvando…"

#: tramado.py:23
msgid "Cuadrado"
msgstr "Quadrado"

#: tramado.py:23
msgid "Euclídeo"
msgstr "Euclidiano"

#: tramado.py:23
msgid "Líneas"
msgstr "Linhas"

#: tramado.py:23 tramado.py:25
msgid "Redondo"
msgstr "Redondo"

#: tramado.py:24
msgid "Hacia dentro"
msgstr "Para dentro"

#: tramado.py:24
msgid "Hacia fuera"
msgstr "Para fora"

#: tramado.py:24
msgid "Sin degradado"
msgstr "Sem degradê"

#: tramado.py:25
msgid "Ovalado"
msgstr "Oval"

#: tramado.py:25
msgid "Sigue el diseño"
msgstr "Segue o desenho"

#: tramado.py:92
#, python-brace-format
msgid "Demasiado grande: {w} × {h} px (máximo {maximo} px por lado). Baja el ancho o la resolución."
msgstr "Grande demais: {w} × {h} px (máximo de {maximo} px por lado). Reduza a largura ou a resolução."

#: tramado.py:244 tramado.py:257
msgid "Con el degradado hacia fuera la imagen pasa del tamaño máximo."
msgstr "Com o degradê para fora, a imagem ultrapassa o tamanho máximo."
