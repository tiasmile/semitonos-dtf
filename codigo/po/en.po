#: semitonos.py:28
msgid "Semitonos para DTF"
msgstr "Halftones for DTF"

#: semitonos.py:32
msgid "Blanca"
msgstr "White"

#: semitonos.py:32
msgid "Gris"
msgstr "Gray"

#: semitonos.py:32
msgid "Negra"
msgstr "Black"

#: semitonos.py:33
msgid "Azul marino"
msgstr "Navy blue"

#: semitonos.py:33
msgid "Roja"
msgstr "Red"

#: semitonos.py:33
msgid "Verde botella"
msgstr "Bottle green"

#: semitonos.py:34
msgid "Comparar"
msgstr "Compare"

#: semitonos.py:34 semitonos.py:895
msgid "Original"
msgstr "Original"

#: semitonos.py:34 semitonos.py:896
msgid "Resultado"
msgstr "Result"

#: semitonos.py:35
msgid "Ajustar"
msgstr "Fit"

#: semitonos.py:36
msgid "Blanco"
msgstr "White"

#: semitonos.py:36
msgid "Color elegido"
msgstr "Chosen color"

#: semitonos.py:36
msgid "Negro"
msgstr "Black"

#: semitonos.py:38
msgid "Barra: arrastrar para comparar · rueda: acercar o alejar · botón derecho: mover la imagen · doble clic: ver entera"
msgstr "Bar: drag to compare · wheel: zoom in or out · right button: move the image · double-click: show the whole image"

#: semitonos.py:243
msgid "☀  Modo claro"
msgstr "☀  Light mode"

#: semitonos.py:243
msgid "☾  Modo oscuro"
msgstr "☾  Dark mode"

#: semitonos.py:290
msgid "1. Imagen"
msgstr "1. Image"

#: semitonos.py:298
msgid "Abrir imagen…"
msgstr "Open image…"

#: semitonos.py:328
msgid "Fondo de la vista:"
msgstr "Preview background:"

#: semitonos.py:335
msgid "Solo cambia lo que ves: el PNG que se guarda no lleva fondo."
msgstr "This only changes what you see: the saved PNG has no background."

#: semitonos.py:336
msgid "El color de la camiseta elegido abajo"
msgstr "The shirt color chosen below"

#: semitonos.py:422
msgid "2. Tamaño de impresión"
msgstr "2. Print size"

#: semitonos.py:424 semitonos.py:488
msgid "Ancho"
msgstr "Width"

#: semitonos.py:428
msgid "Alto"
msgstr "Height"

#. TRADUCTORES: en «Ancho 25 cm  Alto 20 cm  a 300 ppp», la palabra «a» introduce la resolución
#: semitonos.py:436
msgctxt "tamaño de impresión: «25 cm a 300 ppp»"
msgid "a"
msgstr "at"

#. TRADUCTORES: unidad de resolución de impresión (puntos por pulgada), «dpi» en inglés
#: semitonos.py:439
msgid "ppp"
msgstr "dpi"

#: semitonos.py:444
msgid "3. Color de la camiseta"
msgstr "3. Shirt color"

#: semitonos.py:459
msgid "Otro…"
msgstr "Other…"

#. TRADUCTORES: herramienta para coger un color pulsando sobre la imagen (eyedropper / pipette)
#: semitonos.py:463
msgid "Cuentagotas"
msgstr "Eyedropper"

#: semitonos.py:471
msgid "Quitar el color de la camiseta de la imagen"
msgstr "Remove the shirt color from the image"

#. TRADUCTORES: umbral. Los colores más parecidos al de la camiseta que este valor se vuelven transparentes
#: semitonos.py:473
msgid "Quitar hasta"
msgstr "Remove up to"

#. TRADUCTORES: umbral. Los colores más distintos al de la camiseta que este valor quedan totalmente opacos
#: semitonos.py:475
msgid "Opaco desde"
msgstr "Opaque from"

#: semitonos.py:476
msgid "Más parecido que «Quitar hasta»: desaparece. Más distinto que «Opaco desde»: sólido. Lo de en medio: puntos."
msgstr "Closer to the shirt color than “Remove up to”: it disappears. Further from it than “Opaque from”: solid. In between: dots."

#: semitonos.py:480
msgid "4. Degradado del borde"
msgstr "4. Edge fade"

#: semitonos.py:493
msgid "Del 100 % al 0 % con puntos. Hacia dentro difumina el borde; hacia fuera añade un margen alargando los colores. Ovalado / Redondo: en elipse o círculo, sin esquinas."
msgstr "From 100 % to 0 % with dots. Inward softens the edge; outward adds a margin by stretching the colors. Oval / Round: in an ellipse or circle, no corners."

#: semitonos.py:498
msgid "5. Semitono"
msgstr "5. Halftone"

#: semitonos.py:499
msgid "Convertir la transparencia en puntos"
msgstr "Turn transparency into dots"

#. TRADUCTORES: lineatura de la trama (líneas por pulgada, lpi): cuántas filas de puntos caben en una pulgada
#: semitonos.py:502
msgid "Lineatura"
msgstr "Line frequency"

#: semitonos.py:506
msgid "Ángulo"
msgstr "Angle"

#: semitonos.py:512
msgid "Forma del punto"
msgstr "Dot shape"

#. TRADUCTORES: tamaño del punto de la trama (en %); por debajo del mínimo el punto se elimina
#: semitonos.py:517
msgid "Punto mínimo"
msgstr "Minimum dot"

#: semitonos.py:518
msgid "Punto máximo"
msgstr "Maximum dot"

#. TRADUCTORES: «no agarran» = los puntos demasiado pequeños no se adhieren a la tela al estampar. «Sólido» = totalmente relleno
#: semitonos.py:520
msgid "Lineatura más baja = puntos más grandes. Los puntos más pequeños que el mínimo se quitan (no agarran); por encima del máximo, sólido."
msgstr "Lower line frequency = bigger dots. Dots smaller than the minimum are removed (they won't stick); above the maximum, solid."

#: semitonos.py:525
msgid "Guardar PNG para DTF"
msgstr "Save PNG for DTF"

#: semitonos.py:534
msgid "Abrir carpeta"
msgstr "Open folder"

#: semitonos.py:644
msgid "↓   Arrastra aquí la imagen (PNG, JPG, TIFF, WEBP)"
msgstr "↓   Drop the image here (PNG, JPG, TIFF, WEBP)"

#: semitonos.py:658
msgid "Arrastra una imagen PNG, JPG, TIFF o WEBP."
msgstr "Drop a PNG, JPG, TIFF or WEBP image."

#: semitonos.py:658
msgid "Formato no admitido"
msgstr "Unsupported format"

#: semitonos.py:662
msgid "Elegir imagen"
msgstr "Choose image"

#: semitonos.py:663
msgid "Imágenes"
msgstr "Images"

#: semitonos.py:663
msgid "Todos"
msgstr "All"

#: semitonos.py:673
msgid "No se puede abrir"
msgstr "Can't open"

#: semitonos.py:673
#, python-brace-format
msgid ""
"No se puede abrir la imagen:\n"
"{error}"
msgstr ""
"The image can't be opened:\n"
"{error}"

#: semitonos.py:702 semitonos.py:863
msgid "Calculando…"
msgstr "Calculating…"

#: semitonos.py:739
msgid "No hay memoria suficiente para este tamaño. Baja el ancho o la resolución."
msgstr "Not enough memory for this size. Lower the width or the resolution."

#: semitonos.py:764
#, python-brace-format
msgid "✔ Guardado: {nombre}"
msgstr "✔ Saved: {nombre}"

#: semitonos.py:774
msgid "No se ha podido guardar"
msgstr "Could not save"

#: semitonos.py:863
msgid "Arrastra aquí una imagen para empezar"
msgstr "Drop an image here to start"

#: semitonos.py:897
msgid "(ajustado)"
msgstr "(fitted)"

#: semitonos.py:899
msgid "Haz clic en el color de la camiseta (Esc para cancelar)"
msgstr "Click the shirt color (Esc to cancel)"

#: semitonos.py:969
msgid "Color de la camiseta"
msgstr "Shirt color"

#: semitonos.py:1018
#, python-brace-format
msgid "Impresión: {ancho} × {alto} cm a {ppp} ppp ({w} × {h} px)"
msgstr "Print: {ancho} × {alto} cm at {ppp} dpi ({w} × {h} px)"

#: semitonos.py:1021
#, python-brace-format
msgid "trama de {mm} mm"
msgstr "screen pitch {mm} mm"

#: semitonos.py:1025
#, python-brace-format
msgid "⚠ Poca resolución: la imagen original da {ppp} ppp a este tamaño. Se verá borrosa (mejor no pasar de {cm} cm)."
msgstr "⚠ Low resolution: the original image gives {ppp} dpi at this size. It will look blurry (better not to go above {cm} cm)."

#: semitonos.py:1046 semitonos.py:1047
msgid "Guardando…"
msgstr "Saving…"

#: tramado.py:23
msgid "Cuadrado"
msgstr "Square"

#: tramado.py:23
msgid "Euclídeo"
msgstr "Euclidean"

#: tramado.py:23
msgid "Líneas"
msgstr "Lines"

#: tramado.py:23 tramado.py:25
msgid "Redondo"
msgstr "Round"

#: tramado.py:24
msgid "Hacia dentro"
msgstr "Inward"

#: tramado.py:24
msgid "Hacia fuera"
msgstr "Outward"

#: tramado.py:24
msgid "Sin degradado"
msgstr "No fade"

#: tramado.py:25
msgid "Ovalado"
msgstr "Oval"

#: tramado.py:25
msgid "Sigue el diseño"
msgstr "Follow the design"

#: tramado.py:92
#, python-brace-format
msgid "Demasiado grande: {w} × {h} px (máximo {maximo} px por lado). Baja el ancho o la resolución."
msgstr "Too large: {w} × {h} px (maximum {maximo} px per side). Lower the width or the resolution."

#: tramado.py:244 tramado.py:257
msgid "Con el degradado hacia fuera la imagen pasa del tamaño máximo."
msgstr "With the outward fade the image exceeds the maximum size."
