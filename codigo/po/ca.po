#: semitonos.py:28
msgid "Semitonos para DTF"
msgstr "Semitons per a DTF"

#: semitonos.py:32
msgid "Blanca"
msgstr "Blanca"

#: semitonos.py:32
msgid "Gris"
msgstr "Grisa"

#: semitonos.py:32
msgid "Negra"
msgstr "Negra"

#: semitonos.py:33
msgid "Azul marino"
msgstr "Blau marí"

#: semitonos.py:33
msgid "Roja"
msgstr "Vermella"

#: semitonos.py:33
msgid "Verde botella"
msgstr "Verd ampolla"

#: semitonos.py:34
msgid "Comparar"
msgstr "Comparar"

#: semitonos.py:34 semitonos.py:895
msgid "Original"
msgstr "Original"

#: semitonos.py:34 semitonos.py:896
msgid "Resultado"
msgstr "Resultat"

#: semitonos.py:35
msgid "Ajustar"
msgstr "Ajustar"

#: semitonos.py:36
msgid "Blanco"
msgstr "Blanc"

#: semitonos.py:36
msgid "Color elegido"
msgstr "Color triat"

#: semitonos.py:36
msgid "Negro"
msgstr "Negre"

#: semitonos.py:38
msgid "Barra: arrastrar para comparar · rueda: acercar o alejar · botón derecho: mover la imagen · doble clic: ver entera"
msgstr "Barra: arrossega per comparar · roda: apropar o allunyar · botó dret: moure la imatge · doble clic: veure la imatge sencera"

#: semitonos.py:243
msgid "☀  Modo claro"
msgstr "☀  Mode clar"

#: semitonos.py:243
msgid "☾  Modo oscuro"
msgstr "☾  Mode fosc"

#: semitonos.py:290
msgid "1. Imagen"
msgstr "1. Imatge"

#: semitonos.py:298
msgid "Abrir imagen…"
msgstr "Obre una imatge…"

#: semitonos.py:328
msgid "Fondo de la vista:"
msgstr "Fons de la vista:"

#: semitonos.py:335
msgid "Solo cambia lo que ves: el PNG que se guarda no lleva fondo."
msgstr "Només canvia el que veus: el PNG que es desa no té fons."

#: semitonos.py:336
msgid "El color de la camiseta elegido abajo"
msgstr "El color de la samarreta triat a sota"

#: semitonos.py:422
msgid "2. Tamaño de impresión"
msgstr "2. Mida d'impressió"

#: semitonos.py:424 semitonos.py:488
msgid "Ancho"
msgstr "Amplada"

#: semitonos.py:428
msgid "Alto"
msgstr "Alçada"

#. TRADUCTORES: en «Ancho 25 cm  Alto 20 cm  a 300 ppp», la palabra «a» introduce la resolución
#: semitonos.py:436
msgctxt "tamaño de impresión: «25 cm a 300 ppp»"
msgid "a"
msgstr "a"

#. TRADUCTORES: unidad de resolución de impresión (puntos por pulgada), «dpi» en inglés
#: semitonos.py:439
msgid "ppp"
msgstr "ppp"

#: semitonos.py:444
msgid "3. Color de la camiseta"
msgstr "3. Color de la samarreta"

#: semitonos.py:459
msgid "Otro…"
msgstr "Un altre…"

#. TRADUCTORES: herramienta para coger un color pulsando sobre la imagen (eyedropper / pipette)
#: semitonos.py:463
msgid "Cuentagotas"
msgstr "Comptagotes"

#: semitonos.py:471
msgid "Quitar el color de la camiseta de la imagen"
msgstr "Treu el color de la samarreta de la imatge"

#. TRADUCTORES: umbral. Los colores más parecidos al de la camiseta que este valor se vuelven transparentes
#: semitonos.py:473
msgid "Quitar hasta"
msgstr "Treu fins a"

#. TRADUCTORES: umbral. Los colores más distintos al de la camiseta que este valor quedan totalmente opacos
#: semitonos.py:475
msgid "Opaco desde"
msgstr "Opac des de"

#: semitonos.py:476
msgid "Más parecido que «Quitar hasta»: desaparece. Más distinto que «Opaco desde»: sólido. Lo de en medio: puntos."
msgstr "Més semblant al color de la samarreta que «Treu fins a»: desapareix. Més diferent que «Opac des de»: sòlid. El del mig: punts."

#: semitonos.py:480
msgid "4. Degradado del borde"
msgstr "4. Degradat de la vora"

#: semitonos.py:493
msgid "Del 100 % al 0 % con puntos. Hacia dentro difumina el borde; hacia fuera añade un margen alargando los colores. Ovalado / Redondo: en elipse o círculo, sin esquinas."
msgstr "Del 100 % al 0 % amb punts. «Cap a dins» difumina la vora; «Cap a fora» afegeix un marge allargant els colors. Ovalat / Rodó: en el·lipse o cercle, sense cantonades."

#: semitonos.py:498
msgid "5. Semitono"
msgstr "5. Semitò"

#: semitonos.py:499
msgid "Convertir la transparencia en puntos"
msgstr "Converteix la transparència en punts"

#. TRADUCTORES: lineatura de la trama (líneas por pulgada, lpi): cuántas filas de puntos caben en una pulgada
#: semitonos.py:502
msgid "Lineatura"
msgstr "Lineatura"

#: semitonos.py:506
msgid "Ángulo"
msgstr "Angle"

#: semitonos.py:512
msgid "Forma del punto"
msgstr "Forma del punt"

#. TRADUCTORES: tamaño del punto de la trama (en %); por debajo del mínimo el punto se elimina
#: semitonos.py:517
msgid "Punto mínimo"
msgstr "Punt mínim"

#: semitonos.py:518
msgid "Punto máximo"
msgstr "Punt màxim"

#. TRADUCTORES: «no agarran» = los puntos demasiado pequeños no se adhieren a la tela al estampar. «Sólido» = totalmente relleno
#: semitonos.py:520
msgid "Lineatura más baja = puntos más grandes. Los puntos más pequeños que el mínimo se quitan (no agarran); por encima del máximo, sólido."
msgstr "Lineatura més baixa = punts més grans. Els punts més petits que el mínim s'eliminen (no s'enganxen); per sobre del màxim, sòlid."

#: semitonos.py:525
msgid "Guardar PNG para DTF"
msgstr "Desa el PNG per a DTF"

#: semitonos.py:534
msgid "Abrir carpeta"
msgstr "Obre la carpeta"

#: semitonos.py:644
msgid "↓   Arrastra aquí la imagen (PNG, JPG, TIFF, WEBP)"
msgstr "↓   Arrossega aquí la imatge (PNG, JPG, TIFF, WEBP)"

#: semitonos.py:658
msgid "Arrastra una imagen PNG, JPG, TIFF o WEBP."
msgstr "Arrossega una imatge PNG, JPG, TIFF o WEBP."

#: semitonos.py:658
msgid "Formato no admitido"
msgstr "Format no admès"

#: semitonos.py:662
msgid "Elegir imagen"
msgstr "Tria una imatge"

#: semitonos.py:663
msgid "Imágenes"
msgstr "Imatges"

#: semitonos.py:663
msgid "Todos"
msgstr "Tots"

#: semitonos.py:673
msgid "No se puede abrir"
msgstr "No es pot obrir"

#: semitonos.py:673
#, python-brace-format
msgid ""
"No se puede abrir la imagen:\n"
"{error}"
msgstr ""
"No es pot obrir la imatge:\n"
"{error}"

#: semitonos.py:702 semitonos.py:863
msgid "Calculando…"
msgstr "Calculant…"

#: semitonos.py:739
msgid "No hay memoria suficiente para este tamaño. Baja el ancho o la resolución."
msgstr "No hi ha prou memòria per a aquesta mida. Redueix l'amplada o la resolució."

#: semitonos.py:764
#, python-brace-format
msgid "✔ Guardado: {nombre}"
msgstr "✔ Desat: {nombre}"

#: semitonos.py:774
msgid "No se ha podido guardar"
msgstr "No s'ha pogut desar"

#: semitonos.py:863
msgid "Arrastra aquí una imagen para empezar"
msgstr "Arrossega aquí una imatge per començar"

#: semitonos.py:897
msgid "(ajustado)"
msgstr "(ajustat)"

#: semitonos.py:899
msgid "Haz clic en el color de la camiseta (Esc para cancelar)"
msgstr "Fes clic al color de la samarreta (Esc per cancel·lar)"

#: semitonos.py:969
msgid "Color de la camiseta"
msgstr "Color de la samarreta"

#: semitonos.py:1018
#, python-brace-format
msgid "Impresión: {ancho} × {alto} cm a {ppp} ppp ({w} × {h} px)"
msgstr "Impressió: {ancho} × {alto} cm a {ppp} ppp ({w} × {h} px)"

#: semitonos.py:1021
#, python-brace-format
msgid "trama de {mm} mm"
msgstr "trama de {mm} mm"

#: semitonos.py:1025
#, python-brace-format
msgid "⚠ Poca resolución: la imagen original da {ppp} ppp a este tamaño. Se verá borrosa (mejor no pasar de {cm} cm)."
msgstr "⚠ Poca resolució: la imatge original dona {ppp} ppp a aquesta mida. Es veurà borrosa (millor no passar de {cm} cm)."

#: semitonos.py:1046 semitonos.py:1047
msgid "Guardando…"
msgstr "Desant…"

#: tramado.py:23
msgid "Cuadrado"
msgstr "Quadrat"

#: tramado.py:23
msgid "Euclídeo"
msgstr "Euclidià"

#: tramado.py:23
msgid "Líneas"
msgstr "Línies"

#: tramado.py:23 tramado.py:25
msgid "Redondo"
msgstr "Rodó"

#: tramado.py:24
msgid "Hacia dentro"
msgstr "Cap a dins"

#: tramado.py:24
msgid "Hacia fuera"
msgstr "Cap a fora"

#: tramado.py:24
msgid "Sin degradado"
msgstr "Sense degradat"

#: tramado.py:25
msgid "Ovalado"
msgstr "Ovalat"

#: tramado.py:25
msgid "Sigue el diseño"
msgstr "Segueix el disseny"

#: tramado.py:92
#, python-brace-format
msgid "Demasiado grande: {w} × {h} px (máximo {maximo} px por lado). Baja el ancho o la resolución."
msgstr "Massa gran: {w} × {h} px (màxim {maximo} px per costat). Redueix l'amplada o la resolució."

#: tramado.py:244 tramado.py:257
msgid "Con el degradado hacia fuera la imagen pasa del tamaño máximo."
msgstr "Amb el degradat cap a fora la imatge supera la mida màxima."
