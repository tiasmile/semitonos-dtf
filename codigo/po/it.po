#: semitonos.py:28
msgid "Semitonos para DTF"
msgstr "Mezzitoni per DTF"

#: semitonos.py:32
msgid "Blanca"
msgstr "Bianca"

#: semitonos.py:32
msgid "Gris"
msgstr "Grigia"

#: semitonos.py:32
msgid "Negra"
msgstr "Nera"

#: semitonos.py:33
msgid "Azul marino"
msgstr "Blu navy"

#: semitonos.py:33
msgid "Roja"
msgstr "Rossa"

#: semitonos.py:33
msgid "Verde botella"
msgstr "Verde bottiglia"

#: semitonos.py:34
msgid "Comparar"
msgstr "Confronta"

#: semitonos.py:34 semitonos.py:895
msgid "Original"
msgstr "Originale"

#: semitonos.py:34 semitonos.py:896
msgid "Resultado"
msgstr "Risultato"

#: semitonos.py:35
msgid "Ajustar"
msgstr "Adatta"

#: semitonos.py:36
msgid "Blanco"
msgstr "Bianco"

#: semitonos.py:36
msgid "Color elegido"
msgstr "Colore scelto"

#: semitonos.py:36
msgid "Negro"
msgstr "Nero"

#: semitonos.py:38
msgid "Barra: arrastrar para comparar · rueda: acercar o alejar · botón derecho: mover la imagen · doble clic: ver entera"
msgstr "Barra: trascina per confrontare · rotella: ingrandisci o riduci · tasto destro: sposta l'immagine · doppio clic: mostra l'immagine intera"

#: semitonos.py:243
msgid "☀  Modo claro"
msgstr "☀  Tema chiaro"

#: semitonos.py:243
msgid "☾  Modo oscuro"
msgstr "☾  Tema scuro"

#: semitonos.py:290
msgid "1. Imagen"
msgstr "1. Immagine"

#: semitonos.py:298
msgid "Abrir imagen…"
msgstr "Apri immagine…"

#: semitonos.py:328
msgid "Fondo de la vista:"
msgstr "Sfondo dell'anteprima:"

#: semitonos.py:335
msgid "Solo cambia lo que ves: el PNG que se guarda no lleva fondo."
msgstr "Cambia solo ciò che vedi: il PNG salvato non ha sfondo."

#: semitonos.py:336
msgid "El color de la camiseta elegido abajo"
msgstr "Il colore della maglietta scelto sotto"

#: semitonos.py:422
msgid "2. Tamaño de impresión"
msgstr "2. Dimensioni di stampa"

#: semitonos.py:424 semitonos.py:488
msgid "Ancho"
msgstr "Larghezza"

#: semitonos.py:428
msgid "Alto"
msgstr "Altezza"

#. TRADUCTORES: en «Ancho 25 cm  Alto 20 cm  a 300 ppp», la palabra «a» introduce la resolución
#: semitonos.py:436
msgctxt "tamaño de impresión: «25 cm a 300 ppp»"
msgid "a"
msgstr "a"

#. TRADUCTORES: unidad de resolución de impresión (puntos por pulgada), «dpi» en inglés
#: semitonos.py:439
msgid "ppp"
msgstr "dpi"

#: semitonos.py:444
msgid "3. Color de la camiseta"
msgstr "3. Colore della maglietta"

#: semitonos.py:459
msgid "Otro…"
msgstr "Altro…"

#. TRADUCTORES: herramienta para coger un color pulsando sobre la imagen (eyedropper / pipette)
#: semitonos.py:463
msgid "Cuentagotas"
msgstr "Contagocce"

#: semitonos.py:471
msgid "Quitar el color de la camiseta de la imagen"
msgstr "Rimuovi il colore della maglietta dall'immagine"

#. TRADUCTORES: umbral. Los colores más parecidos al de la camiseta que este valor se vuelven transparentes
#: semitonos.py:473
msgid "Quitar hasta"
msgstr "Rimuovi fino a"

#. TRADUCTORES: umbral. Los colores más distintos al de la camiseta que este valor quedan totalmente opacos
#: semitonos.py:475
msgid "Opaco desde"
msgstr "Opaco da"

#: semitonos.py:476
msgid "Más parecido que «Quitar hasta»: desaparece. Más distinto que «Opaco desde»: sólido. Lo de en medio: puntos."
msgstr "Colori più vicini a quello della maglietta di «Rimuovi fino a»: scompaiono. Più lontani di «Opaco da»: pieni. In mezzo: punti."

#: semitonos.py:480
msgid "4. Degradado del borde"
msgstr "4. Sfumatura del bordo"

#: semitonos.py:493
msgid "Del 100 % al 0 % con puntos. Hacia dentro difumina el borde; hacia fuera añade un margen alargando los colores. Ovalado / Redondo: en elipse o círculo, sin esquinas."
msgstr "Dal 100 % allo 0 % con punti. «Verso l'interno» sfuma il bordo; «Verso l'esterno» aggiunge un margine allungando i colori. Ovale / Rotondo: a ellisse o cerchio, senza angoli."

#: semitonos.py:498
msgid "5. Semitono"
msgstr "5. Mezzitoni"

#: semitonos.py:499
msgid "Convertir la transparencia en puntos"
msgstr "Converti la trasparenza in punti"

#. TRADUCTORES: lineatura de la trama (líneas por pulgada, lpi): cuántas filas de puntos caben en una pulgada
#: semitonos.py:502
msgid "Lineatura"
msgstr "Lineatura"

#: semitonos.py:506
msgid "Ángulo"
msgstr "Angolo"

#: semitonos.py:512
msgid "Forma del punto"
msgstr "Forma del punto"

#. TRADUCTORES: tamaño del punto de la trama (en %); por debajo del mínimo el punto se elimina
#: semitonos.py:517
msgid "Punto mínimo"
msgstr "Punto minimo"

#: semitonos.py:518
msgid "Punto máximo"
msgstr "Punto massimo"

#. TRADUCTORES: «no agarran» = los puntos demasiado pequeños no se adhieren a la tela al estampar. «Sólido» = totalmente relleno
#: semitonos.py:520
msgid "Lineatura más baja = puntos más grandes. Los puntos más pequeños que el mínimo se quitan (no agarran); por encima del máximo, sólido."
msgstr "Lineatura più bassa = punti più grandi. I punti più piccoli del minimo vengono rimossi (non aderiscono); oltre il massimo, pieno."

#: semitonos.py:525
msgid "Guardar PNG para DTF"
msgstr "Salva PNG per DTF"

#: semitonos.py:534
msgid "Abrir carpeta"
msgstr "Apri cartella"

#: semitonos.py:644
msgid "↓   Arrastra aquí la imagen (PNG, JPG, TIFF, WEBP)"
msgstr "↓   Trascina qui l'immagine (PNG, JPG, TIFF, WEBP)"

#: semitonos.py:658
msgid "Arrastra una imagen PNG, JPG, TIFF o WEBP."
msgstr "Trascina un'immagine PNG, JPG, TIFF o WEBP."

#: semitonos.py:658
msgid "Formato no admitido"
msgstr "Formato non supportato"

#: semitonos.py:662
msgid "Elegir imagen"
msgstr "Scegli immagine"

#: semitonos.py:663
msgid "Imágenes"
msgstr "Immagini"

#: semitonos.py:663
msgid "Todos"
msgstr "Tutti"

#: semitonos.py:673
msgid "No se puede abrir"
msgstr "Impossibile aprire"

#: semitonos.py:673
#, python-brace-format
msgid ""
"No se puede abrir la imagen:\n"
"{error}"
msgstr ""
"Impossibile aprire l'immagine:\n"
"{error}"

#: semitonos.py:702 semitonos.py:863
msgid "Calculando…"
msgstr "Calcolo in corso…"

#: semitonos.py:739
msgid "No hay memoria suficiente para este tamaño. Baja el ancho o la resolución."
msgstr "Memoria insufficiente per queste dimensioni. Riduci la larghezza o la risoluzione."

#: semitonos.py:764
#, python-brace-format
msgid "✔ Guardado: {nombre}"
msgstr "✔ Salvato: {nombre}"

#: semitonos.py:774
msgid "No se ha podido guardar"
msgstr "Impossibile salvare"

#: semitonos.py:863
msgid "Arrastra aquí una imagen para empezar"
msgstr "Trascina qui un'immagine per iniziare"

#: semitonos.py:897
msgid "(ajustado)"
msgstr "(adattato)"

#: semitonos.py:899
msgid "Haz clic en el color de la camiseta (Esc para cancelar)"
msgstr "Fai clic sul colore della maglietta (Esc per annullare)"

#: semitonos.py:969
msgid "Color de la camiseta"
msgstr "Colore della maglietta"

#: semitonos.py:1018
#, python-brace-format
msgid "Impresión: {ancho} × {alto} cm a {ppp} ppp ({w} × {h} px)"
msgstr "Stampa: {ancho} × {alto} cm a {ppp} dpi ({w} × {h} px)"

#: semitonos.py:1021
#, python-brace-format
msgid "trama de {mm} mm"
msgstr "passo del retino {mm} mm"

#: semitonos.py:1025
#, python-brace-format
msgid "⚠ Poca resolución: la imagen original da {ppp} ppp a este tamaño. Se verá borrosa (mejor no pasar de {cm} cm)."
msgstr "⚠ Bassa risoluzione: l'immagine originale dà {ppp} dpi a queste dimensioni. Sarà sfocata (meglio non superare {cm} cm)."

#: semitonos.py:1046 semitonos.py:1047
msgid "Guardando…"
msgstr "Salvataggio in corso…"

#: tramado.py:23
msgid "Cuadrado"
msgstr "Quadrato"

#: tramado.py:23
msgid "Euclídeo"
msgstr "Euclideo"

#: tramado.py:23
msgid "Líneas"
msgstr "Linee"

#: tramado.py:23 tramado.py:25
msgid "Redondo"
msgstr "Rotondo"

#: tramado.py:24
msgid "Hacia dentro"
msgstr "Verso l'interno"

#: tramado.py:24
msgid "Hacia fuera"
msgstr "Verso l'esterno"

#: tramado.py:24
msgid "Sin degradado"
msgstr "Nessuna sfumatura"

#: tramado.py:25
msgid "Ovalado"
msgstr "Ovale"

#: tramado.py:25
msgid "Sigue el diseño"
msgstr "Segue il disegno"

#: tramado.py:92
#, python-brace-format
msgid "Demasiado grande: {w} × {h} px (máximo {maximo} px por lado). Baja el ancho o la resolución."
msgstr "Troppo grande: {w} × {h} px (massimo {maximo} px per lato). Riduci la larghezza o la risoluzione."

#: tramado.py:244 tramado.py:257
msgid "Con el degradado hacia fuera la imagen pasa del tamaño máximo."
msgstr "Con la sfumatura verso l'esterno l'immagine supera la dimensione massima."
